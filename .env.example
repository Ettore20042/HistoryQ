POSTGRES_DB= Select a name for the PostgreSQL database (e.g., historygenie)
POSTGRES_USER= Select a username for the PostgreSQL database (e.g., historygenie)
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/historygenie
SPRING_DATASOURCE_USERNAME=Add the PostgreSQL username (e.g., historygenie)
SPRING_DATASOURCE_PASSWORD=Set the PostgreSQL password (e.g., replace-with-a-strong-postgres-password)
MINIO_URL=http://silo:9000
MINIO_ACCESS_KEY=Select a MinIO access key (e.g., infini_rag_flow)
MINIO_SECRET_KEY=Select a MinIO secret key (e.g., replace-with-a-strong-minio-secret-key)
MINIO_BUCKET=Select a MinIO bucket name (e.g., historygenie-documents)
JWT_SECRET=Select a strong secret key for JWT signing (e.g., replace-with-a-strong-jwt-secret-key)
JWT_EXPIRATION=86400000
RAGFLOW_BASE_URL=http://ragflow-cpu:9380
RAGFLOW_API_KEY=Add the RAGFlow API key (e.g., your_api_key)
OCR_SERVICE_URL=Select the OCR service URL (e.g., http://churro-ocr:8000)
OCR_API_TOKEN=Add the OCR API token (e.g., your_api_token)
OCR_CONNECT_TIMEOUT=10s
OCR_READ_TIMEOUT=30m
OCR_JOB_TIMEOUT=30m
OCR_JOB_POLL_INTERVAL=1s
APP_CORS_ALLOWED_ORIGIN=https://historyq.example.edu
HISTORYQ_HTTP_PORT=18080
